    /* Grid positions: [atomicNumber, col(1-18), row(1-7)] */
    /* We place each element by its group/period */
    function buildPT() {
      const grid = document.getElementById('pt-grid');
      grid.innerHTML = '';

      /* Create 7 rows × 18 cols of placeholder cells */
      const cells = {}; /* "row,col" -> element */
      ELEMENTS.forEach(e => {
        const [sym,name,num,mass,cat,grp,period,desc] = e;
        if (grp === 0) return; /* lanthanides/actinides placed below */
        cells[period+','+grp] = e;
      });

      /* Place main table rows 1-7 */
      for (let row = 1; row <= 7; row++) {
        for (let col = 1; col <= 18; col++) {
          const el = cells[row+','+col];
          const div = document.createElement('div');
          if (el) {
            const [sym,name,num,mass,cat] = el;
            div.className = 'el ' + CATEGORIES[cat].cls;
            div.setAttribute('data-num', num);
            div.innerHTML = `<span class="num">${num}</span><span class="sym">${sym}</span><span class="name">${name}</span>`;
            div.addEventListener('click', () => showEl(el));
          } else {
            div.style.minHeight = '56px';
          }
          grid.appendChild(div);
        }
      }

      /* Spacer rows between main table and lanthanides */
      for (let col = 1; col <= 18; col++) {
        const sp = document.createElement('div');
        sp.style.minHeight = '8px';
        grid.appendChild(sp);
      }

      /* Lanthanides row (57-71) */
      for (let col = 1; col <= 18; col++) {
        const lNum = 56 + col; /* 57-71 for cols 1-15 */
        const el = ELEMENTS.find(e => e[2] === lNum && e[4]==='lanthanide');
        const div = document.createElement('div');
        if (el && col >= 4 && col <= 18) {
          const [sym,name,num,mass,cat] = el;
          div.className = 'el ' + CATEGORIES[cat].cls;
          div.setAttribute('data-num', num);
          div.innerHTML = `<span class="num">${num}</span><span class="sym">${sym}</span><span class="name">${name}</span>`;
          div.addEventListener('click', () => showEl(el));
        } else { div.style.minHeight='56px'; }
        grid.appendChild(div);
      }

      /* Actinides row (89-103) */
      for (let col = 1; col <= 18; col++) {
        const aNum = 88 + col;
        const el = ELEMENTS.find(e => e[2] === aNum && e[4]==='actinide');
        const div = document.createElement('div');
        if (el && col >= 4 && col <= 18) {
          const [sym,name,num,mass,cat] = el;
          div.className = 'el ' + CATEGORIES[cat].cls;
          div.setAttribute('data-num', num);
          div.innerHTML = `<span class="num">${num}</span><span class="sym">${sym}</span><span class="name">${name}</span>`;
          div.addEventListener('click', () => showEl(el));
        } else { div.style.minHeight='56px'; }
        grid.appendChild(div);
      }

      buildLegend();
    }

    function buildLegend() {
      const leg = document.getElementById('pt-legend');
      leg.innerHTML = Object.entries(CATEGORIES).map(([k,v]) =>
        `<div class="pt-leg-item">
          <div class="pt-leg-dot ${v.cls}"></div>
          <span>${v.label}</span>
        </div>`
      ).join('');
    }

    function showEl(el) {
      const [sym,name,num,mass,cat,grp,period,desc] = el;
      const catInfo = CATEGORIES[cat];
      const bigSym = document.getElementById('el-big-sym');
      bigSym.textContent = sym;
      bigSym.className = 'el-big-sym ' + catInfo.cls;
      document.getElementById('el-name').textContent = name;
      document.getElementById('el-category').textContent = catInfo.label;
      document.getElementById('el-props').innerHTML = `
        <div class="el-prop"><div class="el-prop-label">Atomic Number</div><div class="el-prop-val">${num}</div></div>
        <div class="el-prop"><div class="el-prop-label">Atomic Mass</div><div class="el-prop-val">${mass} u</div></div>
        <div class="el-prop"><div class="el-prop-label">Symbol</div><div class="el-prop-val">${sym}</div></div>
        <div class="el-prop"><div class="el-prop-label">Period / Group</div><div class="el-prop-val">${period} / ${grp||'—'}</div></div>
      `;
      document.getElementById('el-desc').textContent = desc;
      document.getElementById('el-detail').classList.add('open');
    }

    function closeEl() {
      document.getElementById('el-detail').classList.remove('open');
    }

    function searchEl(q) {
      const qLow = q.toLowerCase().trim();
      document.querySelectorAll('.el').forEach(el => {
        if (!qLow) { el.classList.remove('dimmed'); return; }
        const num = el.getAttribute('data-num');
        const eData = ELEMENTS.find(e => String(e[2]) === num);
        if (!eData) return;
        const match = eData[0].toLowerCase().includes(qLow) ||
                      eData[1].toLowerCase().includes(qLow) ||
                      String(eData[2]).includes(qLow);
        el.classList.toggle('dimmed', !match);
      });
    }

    document.getElementById('el-detail').addEventListener('click', function(e){
      if(e.target===this) closeEl();
    });

    /* ============================================================
       SCIENTIFIC CALCULATOR
    ============================================================ */
    let calcExpr  = '';
    let calcMode  = 'deg'; /* deg | rad */
    let calcNew   = true;

    function setMode(m) {
      calcMode = m;
      document.getElementById('mode-deg').classList.toggle('on', m==='deg');
      document.getElementById('mode-rad').classList.toggle('on', m==='rad');
    }

    function updateDisplay(val, expr) {
      document.getElementById('calc-display').textContent = val;
      if (expr !== undefined) document.getElementById('calc-expr').textContent = expr;
    }

    function calcPush(val) {
      if (calcNew && !isNaN(val) && val !== '.') {
        calcExpr = val;
        calcNew = false;
      } else {
        calcExpr += val;
        calcNew = false;
      }
      updateDisplay(calcExpr);
    }

    function calcFn(fn) {
      calcNew = false;
      const toRad = x => calcMode === 'deg' ? x * Math.PI / 180 : x;
      const toDeg = x => calcMode === 'deg' ? x * 180 / Math.PI : x;
      let cur;
      try { cur = parseFloat(eval(calcExpr)); } catch(e) { cur = 0; }

      let result;
      switch(fn) {
        case 'sin':   result = Math.sin(toRad(cur)); break;
        case 'cos':   result = Math.cos(toRad(cur)); break;
        case 'tan':   result = Math.tan(toRad(cur)); break;
        case 'asin':  result = toDeg(Math.asin(cur)); break;
        case 'acos':  result = toDeg(Math.acos(cur)); break;
        case 'atan':  result = toDeg(Math.atan(cur)); break;
        case 'log':   result = Math.log10(cur); break;
        case 'ln':    result = Math.log(cur); break;
        case 'sqrt':  result = Math.sqrt(cur); break;
        case 'cbrt':  result = Math.cbrt(cur); break;
        case 'sq':    result = cur * cur; break;
        case 'cube':  result = cur * cur * cur; break;
        case 'inv':   result = 1 / cur; break;
        case 'abs':   result = Math.abs(cur); break;
        case 'exp':   result = Math.exp(cur); break;
        case 'floor': result = Math.floor(cur); break;
        case 'ceil':  result = Math.ceil(cur); break;
        case 'pi':    calcExpr += String(Math.PI); updateDisplay(calcExpr); return;
        case 'e':     calcExpr += String(Math.E);  updateDisplay(calcExpr); return;
        default: return;
      }
      result = parseFloat(result.toPrecision(10));
      document.getElementById('calc-expr').textContent = fn+'('+cur+') =';
      calcExpr = String(result);
      updateDisplay(calcExpr);
      calcNew = true;
    }

    function calcEquals() {
      try {
        const expr = calcExpr
          .replace(/×/g,'*').replace(/÷/g,'/')
          .replace(/\^/g,'**');
        const result = eval(expr); /* safe: user-controlled input only */
        document.getElementById('calc-expr').textContent = calcExpr + ' =';
        const pretty = parseFloat(parseFloat(result).toPrecision(12));
        calcExpr = String(pretty);
        updateDisplay(calcExpr);
        calcNew = true;
      } catch(e) {
        updateDisplay('Error');
        calcExpr = '';
        calcNew = true;
      }
    }

    function calcClear() { calcExpr=''; calcNew=true; updateDisplay('0',''); }
    function calcBack()  {
      calcExpr = calcExpr.slice(0,-1);
      updateDisplay(calcExpr||'0');
    }

    function insertConst(val) {
      switchTab('calculator', document.querySelectorAll('.tab-btn')[1]);
      if (calcNew) { calcExpr = val; calcNew = false; }
      else calcExpr += val;
      updateDisplay(calcExpr);
    }

    /* Build calculator buttons */
    function buildCalc() {
      const layout = [
        /* row 1: functions */
        {l:'sin',  t:'fn', a:()=>calcFn('sin')},
        {l:'cos',  t:'fn', a:()=>calcFn('cos')},
        {l:'tan',  t:'fn', a:()=>calcFn('tan')},
        {l:'log',  t:'fn', a:()=>calcFn('log')},
        {l:'ln',   t:'fn', a:()=>calcFn('ln')},
        /* row 2 */
        {l:'x²',   t:'fn', a:()=>calcFn('sq')},
        {l:'x³',   t:'fn', a:()=>calcFn('cube')},
        {l:'√x',   t:'fn', a:()=>calcFn('sqrt')},
        {l:'1/x',  t:'fn', a:()=>calcFn('inv')},
        {l:'|x|',  t:'fn', a:()=>calcFn('abs')},
        /* row 3 */
        {l:'π',    t:'fn', a:()=>calcFn('pi')},
        {l:'e',    t:'fn', a:()=>calcFn('e')},
        {l:'(',    t:'num', a:()=>calcPush('(')},
        {l:')',    t:'num', a:()=>calcPush(')')},
        {l:'DEL',  t:'clr', a:()=>calcBack()},
        /* row 4 */
        {l:'7',    t:'num', a:()=>calcPush('7')},
        {l:'8',    t:'num', a:()=>calcPush('8')},
        {l:'9',    t:'num', a:()=>calcPush('9')},
        {l:'÷',    t:'op',  a:()=>calcPush('/')},
        {l:'AC',   t:'clr', a:()=>calcClear()},
        /* row 5 */
        {l:'4',    t:'num', a:()=>calcPush('4')},
        {l:'5',    t:'num', a:()=>calcPush('5')},
        {l:'6',    t:'num', a:()=>calcPush('6')},
        {l:'×',    t:'op',  a:()=>calcPush('*')},
        {l:'xʸ',   t:'fn',  a:()=>calcPush('**')},
        /* row 6 */
        {l:'1',    t:'num', a:()=>calcPush('1')},
        {l:'2',    t:'num', a:()=>calcPush('2')},
        {l:'3',    t:'num', a:()=>calcPush('3')},
        {l:'−',    t:'op',  a:()=>calcPush('-')},
        {l:'eˣ',   t:'fn',  a:()=>calcFn('exp')},
        /* row 7 */
        {l:'0',    t:'num', a:()=>calcPush('0'), span:2},
        {l:'.',    t:'num', a:()=>calcPush('.')},
        {l:'+',    t:'op',  a:()=>calcPush('+')},
        {l:'=',    t:'eq',  a:()=>calcEquals()},
      ];

      const grid = document.getElementById('calc-grid');
      grid.innerHTML = '';
      layout.forEach(btn => {
        const b = document.createElement('button');
        b.className = 'cb ' + btn.t + (btn.span ? ' span'+btn.span : '');
        b.textContent = btn.l;
        b.addEventListener('click', btn.a);
        grid.appendChild(b);
      });
    }

    /* Keyboard support for calculator */
    document.addEventListener('keydown', e => {
      if (document.getElementById('tab-calculator').classList.contains('active')) {
        const key = e.key;
        if ('0123456789'.includes(key)) calcPush(key);
        else if (key === '+') calcPush('+');
        else if (key === '-') calcPush('-');
        else if (key === '*') calcPush('*');
        else if (key === '/') { e.preventDefault(); calcPush('/'); }
        else if (key === '.') calcPush('.');
        else if (key === '(' || key === ')') calcPush(key);
        else if (key === 'Enter' || key === '=') { e.preventDefault(); calcEquals(); }
        else if (key === 'Backspace') calcBack();
        else if (key === 'Escape') calcClear();
      }
      if (key === 'Escape') {
        closeEl();
        if (typeof closeVoiceModal === 'function') closeVoiceModal();
      }
    });

    /* ===== INIT ===== */
    buildPT();
    buildCalc();
  </script>
