<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Exam Master - Science Tools</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="style.css"/>
  <script>(function(){var t=localStorage.getItem('sb_theme')||'light';document.documentElement.setAttribute('data-theme',t);})();</script>
  <style>
    /* ===== TABS ===== */
    .tab-bar { display:flex; gap:0; border-bottom:2px solid var(--border); margin-bottom:32px; }
    .tab-btn {
      padding:11px 28px; font-size:0.9rem; font-weight:700; border:none;
      background:none; color:var(--text-secondary); cursor:pointer;
      border-bottom:3px solid transparent; margin-bottom:-2px;
      font-family:inherit; transition:color 0.15s, border-color 0.15s;
    }
    .tab-btn.active { color:var(--accent); border-bottom-color:var(--accent); }
    .tab-btn:hover:not(.active) { color:var(--text); }

    .tab-panel { display:none; }
    .tab-panel.active { display:block; }

    /* ===== PERIODIC TABLE ===== */
    .pt-controls {
      display:flex; align-items:center; gap:12px; flex-wrap:wrap; margin-bottom:20px;
    }
    .pt-search {
      flex:1; min-width:200px; max-width:320px;
      padding:9px 14px; border:1.5px solid var(--border); border-radius:var(--radius);
      font-size:0.9rem; color:var(--text); background:var(--surface); font-family:inherit;
    }
    .pt-search:focus { outline:none; border-color:var(--accent); box-shadow:0 0 0 3px rgba(79,70,229,0.12); }

    .pt-legend { display:flex; flex-wrap:wrap; gap:8px; }
    .pt-leg-item {
      display:flex; align-items:center; gap:5px;
      font-size:0.75rem; font-weight:600; color:var(--text-secondary);
    }
    .pt-leg-dot { width:12px; height:12px; border-radius:3px; }

    .pt-scroll { overflow-x:auto; padding-bottom:8px; }
    .pt-grid {
      display:grid;
      grid-template-columns: repeat(18, minmax(52px,1fr));
      gap:3px;
      min-width:950px;
    }

    .el {
      border-radius:6px; padding:4px 3px; text-align:center;
      cursor:pointer; transition:transform 0.12s, box-shadow 0.12s;
      border:1px solid rgba(0,0,0,0.08); position:relative;
      min-height:56px; display:flex; flex-direction:column;
      align-items:center; justify-content:center;
    }
    .el:hover { transform:scale(1.12); box-shadow:0 6px 18px rgba(0,0,0,0.18); z-index:10; }
    .el.dimmed { opacity:0.2; }
    .el .num { font-size:0.6rem; font-weight:700; opacity:0.8; line-height:1; }
    .el .sym { font-size:1.05rem; font-weight:800; line-height:1.1; }
    .el .name { font-size:0.5rem; font-weight:500; opacity:0.85; line-height:1.2; white-space:nowrap; }

    /* category colours */
    .cat-alkali      { background:#fce7f3; color:#9d174d; }
    .cat-alkaline    { background:#fef3c7; color:#92400e; }
    .cat-transition  { background:#dbeafe; color:#1e40af; }
    .cat-post        { background:#d1fae5; color:#065f46; }
    .cat-metalloid   { background:#ede9fe; color:#5b21b6; }
    .cat-nonmetal    { background:#ecfdf5; color:#065f46; }
    .cat-halogen     { background:#fdf2f8; color:#9d174d; }
    .cat-noble       { background:#f0f9ff; color:#075985; }
    .cat-lanthanide  { background:#fff7ed; color:#9a3412; }
    .cat-actinide    { background:#fef2f2; color:#991b1b; }

    [data-theme="dark"] .cat-alkali      { background:#4c0519; color:#fda4af; }
    [data-theme="dark"] .cat-alkaline    { background:#1c1200; color:#fcd34d; }
    [data-theme="dark"] .cat-transition  { background:#1e1b4b; color:#a5b4fc; }
    [data-theme="dark"] .cat-post        { background:#052e16; color:#86efac; }
    [data-theme="dark"] .cat-metalloid   { background:#2e1065; color:#c4b5fd; }
    [data-theme="dark"] .cat-nonmetal    { background:#042f2e; color:#5eead4; }
    [data-theme="dark"] .cat-halogen     { background:#3b0764; color:#e9d5ff; }
    [data-theme="dark"] .cat-noble       { background:#0c1a2e; color:#93c5fd; }
    [data-theme="dark"] .cat-lanthanide  { background:#431407; color:#fdba74; }
    [data-theme="dark"] .cat-actinide    { background:#450a0a; color:#fca5a5; }

    /* Element detail card */
    .el-detail {
      display:none; position:fixed; inset:0;
      background:rgba(0,0,0,0.55); z-index:800;
      align-items:center; justify-content:center;
      backdrop-filter:blur(4px);
    }
    .el-detail.open { display:flex; }
    .el-card {
      background:var(--surface); border:1px solid var(--border);
      border-radius:20px; padding:36px 32px; width:420px; max-width:94vw;
      box-shadow:0 24px 64px rgba(0,0,0,0.3);
      animation:popIn 0.17s ease;
    }
    @keyframes popIn { from{transform:scale(0.92);opacity:0} to{transform:scale(1);opacity:1} }
    .el-card-header { display:flex; align-items:center; gap:20px; margin-bottom:24px; }
    .el-big-sym {
      width:72px; height:72px; border-radius:12px;
      display:flex; align-items:center; justify-content:center;
      font-size:2rem; font-weight:900; flex-shrink:0;
    }
    .el-card-header h2 { font-size:1.4rem; font-weight:800; color:var(--text); margin-bottom:3px; }
    .el-card-header p  { font-size:0.85rem; color:var(--text-secondary); }
    .el-props { display:grid; grid-template-columns:1fr 1fr; gap:10px; margin-bottom:22px; }
    .el-prop { background:var(--bg-alt); border-radius:8px; padding:10px 12px; }
    .el-prop-label { font-size:0.72rem; font-weight:700; color:var(--text-secondary); text-transform:uppercase; letter-spacing:0.5px; margin-bottom:3px; }
    .el-prop-val   { font-size:0.95rem; font-weight:700; color:var(--text); }
    .el-desc { font-size:0.875rem; color:var(--text-secondary); line-height:1.65; margin-bottom:20px; }
    .el-close { width:100%; }

    /* ===== CALCULATOR ===== */
    .calc-wrap {
      display:flex; gap:32px; flex-wrap:wrap; align-items:flex-start;
      justify-content:center;
    }

    .calc-box {
      background:var(--surface); border:1px solid var(--border);
      border-radius:20px; padding:24px; width:360px; max-width:100%;
      box-shadow:var(--shadow-md);
    }

    .calc-screen {
      background:#0f172a; border-radius:12px; padding:16px 18px;
      margin-bottom:16px; min-height:80px;
      display:flex; flex-direction:column; align-items:flex-end; justify-content:flex-end;
    }
    .calc-expr { font-size:0.78rem; color:#64748b; min-height:18px; word-break:break-all; }
    .calc-display {
      font-size:2.2rem; font-weight:700; color:#fff;
      word-break:break-all; text-align:right; line-height:1.2;
    }

    .calc-mode {
      display:flex; gap:6px; margin-bottom:12px; flex-wrap:wrap;
    }
    .mode-btn {
      flex:1; padding:7px 10px; font-size:0.76rem; font-weight:700;
      border:1px solid var(--border); border-radius:6px; background:var(--bg-alt);
      color:var(--text-secondary); cursor:pointer; font-family:inherit;
      transition:background 0.12s, color 0.12s;
    }
    .mode-btn.on { background:var(--accent); color:#fff; border-color:var(--accent); }

    .calc-grid {
      display:grid; grid-template-columns:repeat(5,1fr); gap:7px;
    }

    .cb {
      padding:0; height:50px; border-radius:9px; border:none;
      font-size:0.85rem; font-weight:700; cursor:pointer;
      font-family:inherit; transition:transform 0.1s, filter 0.1s;
      display:flex; align-items:center; justify-content:center;
    }
    .cb:hover  { filter:brightness(1.1); }
    .cb:active { transform:scale(0.93); }
    .cb.num  { background:var(--surface-2,#f8fafc); color:var(--text); border:1px solid var(--border); }
    .cb.op   { background:#eef2ff; color:#3730a3; border:1px solid #c7d2fe; }
    .cb.fn   { background:var(--bg-alt); color:var(--text); border:1px solid var(--border); font-size:0.78rem; }
    .cb.eq   { background:var(--accent); color:#fff; border:none; font-size:1.1rem; }
    .cb.clr  { background:#fef2f2; color:#dc2626; border:1px solid #fecaca; }
    .cb.span2 { grid-column:span 2; }

    [data-theme="dark"] .cb.num { background:#1e293b; border-color:#334155; }
    [data-theme="dark"] .cb.op  { background:#1e1b4b; color:#a5b4fc; border-color:#3730a3; }
    [data-theme="dark"] .cb.fn  { background:#1e293b; border-color:#334155; }
    [data-theme="dark"] .cb.clr { background:#2d0a0a; color:#f87171; border-color:#7f1d1d; }

    /* Physics formulas reference */
    .formula-box {
      background:var(--surface); border:1px solid var(--border);
      border-radius:20px; padding:24px; flex:1; min-width:280px;
      max-width:380px; box-shadow:var(--shadow);
    }
    .formula-box h3 { font-size:1rem; font-weight:800; color:var(--text); margin-bottom:16px; }
    .formula-list { display:flex; flex-direction:column; gap:8px; }
    .formula-item {
      background:var(--bg-alt); border-radius:8px; padding:10px 14px;
      border-left:3px solid var(--accent);
    }
    .formula-item .fl { font-size:0.72rem; font-weight:600; color:var(--text-secondary); text-transform:uppercase; letter-spacing:0.4px; margin-bottom:3px; }
    .formula-item .fv { font-size:0.9rem; font-weight:700; color:var(--text); font-family:monospace; }

    .const-list { display:flex; flex-direction:column; gap:7px; margin-top:14px; }
    .const-item {
      display:flex; align-items:center; justify-content:space-between;
      background:var(--bg-alt); border-radius:8px; padding:9px 13px;
    }
    .const-item .cl { font-size:0.82rem; font-weight:600; color:var(--text); }
    .const-item .cv { font-size:0.78rem; color:var(--accent); font-family:monospace; font-weight:700; }
    .btn-use {
      font-size:0.7rem; font-weight:700; padding:3px 9px; border-radius:5px;
      background:var(--accent); color:#fff; border:none; cursor:pointer;
      font-family:inherit; margin-left:8px; white-space:nowrap;
      transition:background 0.12s;
    }
    .btn-use:hover { background:var(--accent-hover,#4338ca); }
  </style>
</head>
<body>

  <nav class="navbar">
    <div class="nav-brand">Exam<span>Master</span></div>
    <ul class="nav-links">
      <li><a href="index.html">Home</a></li>
      <li><a href="tools.html">Tools</a></li>
