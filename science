  <!-- VOICE MODAL -->
  <div class="voice-modal-overlay" id="voice-modal-overlay">
    <div class="voice-modal">
      <h2>Voice Assistant</h2>
      <p class="vm-sub">Navigate Exam Master with your voice</p>
      <button class="voice-orb" id="voice-orb" onclick="startListening()">
        <svg viewBox="0 0 24 24"><path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3zm-1 19.93V22h2v-1.07A8 8 0 0 0 20 13h-2a6 6 0 0 1-12 0H4a8 8 0 0 0 7 7.93z"/></svg>
      </button>
      <div class="voice-status" id="voice-status">Click the button to speak</div>
      <div class="voice-output" id="voice-output"></div>
      <div class="vm-commands">
        <span class="vm-cmd" onclick="runQuickCommand('go home')">Home</span>
        <span class="vm-cmd" onclick="runQuickCommand('open tools')">Tools</span>
      </div>
      <button class="voice-close" onclick="closeVoiceModal()">Close</button>
    </div>
  </div>

  <!-- ELEMENT DETAIL MODAL -->
  <div class="el-detail" id="el-detail">
    <div class="el-card">
      <div class="el-card-header">
        <div class="el-big-sym" id="el-big-sym"></div>
        <div>
          <h2 id="el-name"></h2>
          <p id="el-category"></p>
        </div>
      </div>
      <div class="el-props" id="el-props"></div>
      <p class="el-desc" id="el-desc"></p>
      <button class="btn-primary el-close" onclick="closeEl()">Close</button>
    </div>
  </div>

  <div class="page-header">
    <h1>Science Tools</h1>
    <p>Periodic table and scientific calculator for Physics and Chemistry students</p>
  </div>

  <section class="section">
    <div class="tab-bar">
      <button class="tab-btn active" onclick="switchTab('periodic',this)">Periodic Table</button>
      <button class="tab-btn"       onclick="switchTab('calculator',this)">Scientific Calculator</button>
    </div>

    <!-- ===== PERIODIC TABLE TAB ===== -->
    <div class="tab-panel active" id="tab-periodic">
      <div class="pt-controls">
        <input type="text" class="pt-search" id="pt-search" placeholder="Search element, symbol or atomic number..." oninput="searchEl(this.value)"/>
        <div class="pt-legend" id="pt-legend"></div>
      </div>
      <div class="pt-scroll">
        <div class="pt-grid" id="pt-grid"></div>
      </div>
      <p style="font-size:0.8rem;color:var(--text-secondary);margin-top:12px;">Click any element for detailed information.</p>
    </div>

    <!-- ===== CALCULATOR TAB ===== -->
    <div class="tab-panel" id="tab-calculator">
      <div class="calc-wrap">

        <!-- CALCULATOR -->
        <div class="calc-box">
          <div class="calc-screen">
            <div class="calc-expr" id="calc-expr"></div>
            <div class="calc-display" id="calc-display">0</div>
          </div>
          <div class="calc-mode">
            <button class="mode-btn on" id="mode-deg" onclick="setMode('deg')">DEG</button>
            <button class="mode-btn"    id="mode-rad" onclick="setMode('rad')">RAD</button>
          </div>
          <div class="calc-grid" id="calc-grid"></div>
        </div>

        <!-- PHYSICS REFERENCE -->
        <div class="formula-box">
          <h3>Physics Formulas</h3>
          <div class="formula-list">
            <div class="formula-item"><div class="fl">Force</div><div class="fv">F = m × a</div></div>
            <div class="formula-item"><div class="fl">Kinetic Energy</div><div class="fv">KE = ½mv²</div></div>
            <div class="formula-item"><div class="fl">Potential Energy</div><div class="fv">PE = mgh</div></div>
            <div class="formula-item"><div class="fl">Work Done</div><div class="fv">W = F × d</div></div>
            <div class="formula-item"><div class="fl">Power</div><div class="fv">P = W / t</div></div>
            <div class="formula-item"><div class="fl">Ohm's Law</div><div class="fv">V = I × R</div></div>
            <div class="formula-item"><div class="fl">Wave Speed</div><div class="fv">v = f × λ</div></div>
            <div class="formula-item"><div class="fl">Pressure</div><div class="fv">P = F / A</div></div>
            <div class="formula-item"><div class="fl">Density</div><div class="fv">ρ = m / V</div></div>
            <div class="formula-item"><div class="fl">Velocity</div><div class="fv">v = u + at</div></div>
          </div>
          <h3 style="margin-top:20px;">Constants</h3>
          <div class="const-list">
            <div class="const-item"><span class="cl">Speed of light</span><span style="display:flex;align-items:center;"><span class="cv">3×10⁸ m/s</span><button class="btn-use" onclick="insertConst('3e8')">Use</button></span></div>
            <div class="const-item"><span class="cl">Gravity (g)</span><span style="display:flex;align-items:center;"><span class="cv">9.81 m/s²</span><button class="btn-use" onclick="insertConst('9.81')">Use</button></span></div>
            <div class="const-item"><span class="cl">Planck (h)</span><span style="display:flex;align-items:center;"><span class="cv">6.626×10⁻³⁴</span><button class="btn-use" onclick="insertConst('6.626e-34')">Use</button></span></div>
            <div class="const-item"><span class="cl">Avogadro</span><span style="display:flex;align-items:center;"><span class="cv">6.022×10²³</span><button class="btn-use" onclick="insertConst('6.022e23')">Use</button></span></div>
            <div class="const-item"><span class="cl">Electron charge</span><span style="display:flex;align-items:center;"><span class="cv">1.602×10⁻¹⁹ C</span><button class="btn-use" onclick="insertConst('1.602e-19')">Use</button></span></div>
            <div class="const-item"><span class="cl">Boltzmann (k)</span><span style="display:flex;align-items:center;"><span class="cv">1.381×10⁻²³</span><button class="btn-use" onclick="insertConst('1.381e-23')">Use</button></span></div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <footer class="footer">
    <p>Exam Master 2026 &mdash; Built for students who refuse to give up.</p>
  </footer>

